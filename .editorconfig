root = true

[*.axaml]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C# conventions retained for this project:
# https://learn.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/identifier-names
# https://learn.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/coding-conventions
# Keep public XML documentation accurate; use descriptive local names.
# Handle exceptions only when recovery, rollback, or UI reporting is possible.
# Prefer async/await for I/O and dispose owned resources with using.
# Prefer interpolation, collection expressions, and raw strings when clearer.
# The width is a wrapping target; keep indivisible literals intact.
[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 65

# Allman braces and one statement per line.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Use explicit types unless construction, a cast, or a literal shows the type.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_operator_placement_when_wrapping = beginning_of_line
csharp_style_prefer_simple_using_statement = true:suggestion
dotnet_style_prefer_collection_expression = when_types_exactly_match:suggestion
csharp_style_prefer_method_group_conversion = true:suggestion

# Naming rules: constants, fields, types, members, and parameters.
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_fields_prefixed.symbols = static_fields
dotnet_naming_rule.static_fields_prefixed.style = static_camel_case
dotnet_naming_rule.static_fields_prefixed.severity = warning
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_rule.instance_fields_prefixed.symbols = instance_fields
dotnet_naming_rule.instance_fields_prefixed.style = underscore_camel_case
dotnet_naming_rule.instance_fields_prefixed.severity = warning
dotnet_naming_symbols.instance_fields.applicable_kinds = field
dotnet_naming_symbols.instance_fields.applicable_accessibilities = private, internal

dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = interface_pascal_case
dotnet_naming_rule.interfaces_prefixed.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, namespace

dotnet_naming_rule.members_pascal_case.symbols = members
dotnet_naming_rule.members_pascal_case.style = pascal_case
dotnet_naming_rule.members_pascal_case.severity = warning
dotnet_naming_symbols.members.applicable_kinds = property, event, method

dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case
dotnet_naming_rule.parameters_camel_case.severity = warning
dotnet_naming_symbols.parameters.applicable_kinds = parameter

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.static_camel_case.capitalization = camel_case
dotnet_naming_style.static_camel_case.required_prefix = s_
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case
dotnet_naming_style.interface_pascal_case.required_prefix = I

# Surface convention violations during build as well as in the editor.
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# Factory method names do not make their return types obvious to a reader.
dotnet_diagnostic.IDE0007.severity = suggestion

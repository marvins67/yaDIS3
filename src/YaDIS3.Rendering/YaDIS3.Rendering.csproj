<Project Sdk="Microsoft.NET.Sdk">
  <!-- Original graphics, templates and fonts: Frédéric L'hote / Fred-L.
       Origins 1.2, GLASS Revisited 1.0 and GLASS Revisited (TV Posters) 1.0.
       Original embedded authorship and font metadata preserved.

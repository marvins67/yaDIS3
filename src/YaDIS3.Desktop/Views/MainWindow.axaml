<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YaDIS3.Desktop.ViewModels" xmlns:core="using:YaDIS3.Core" xmlns:render="using:YaDIS3.Rendering"
        x:Class="YaDIS3.Desktop.Views.MainWindow" x:DataType="vm:MainWindowViewModel" Title="yaDIS3" Width="1140" Height="850" MinWidth="960" MinHeight="700" FontSize="12">
  <Grid Margin="8,6,8,0" RowDefinitions="Auto,*,6,255,24">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="4" IsEnabled="{Binding !IsBusy}">
        <Button Classes="toolbar">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M2,0 L7,5 L5,8 L10,13 L14,11 L20,16 L16,20 L11,15 L8,16 L3,11 L4,7 L0,3 Z" Fill="#7D8790" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Configurer" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="4" MinWidth="230">
                <TextBlock Text="Bibliothèque" Classes="section" />
                <Button Content="Ouvrir une bibliothèque…" Click="OpenWorkspace" />
                <Button Content="Créer une bibliothèque…" Click="CreateWorkspace" />
                <Button Content="Ajouter une série manuelle…" Click="AddManualSeries" />
                <Separator />
                <Button Content="Configuration TVDB…" Click="ConfigureTvdb" />
                <Button Content="Templates et export Dune…" Click="ShowDuneSettings" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="toolbar" Command="{Binding ProcessCommand}" IsEnabled="{Binding HasCard}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M9,0 L13,0 L14,4 L17,5 L20,3 L23,6 L21,9 L22,12 L26,13 L26,17 L22,18 L21,21 L23,24 L20,27 L17,25 L14,26 L13,30 L9,30 L8,26 L5,25 L2,27 L0,24 L2,21 L1,18 L0,17 L0,13 L3,12 L4,9 L2,6 L5,3 L8,5 Z M11,9 A6,6 0 1 0 11,21 A6,6 0 1 0 11,9 Z" Fill="#90999F" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Traiter" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="toolbar" Command="{Binding ExportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M1,1 L19,1 L19,14 L12,14 L12,18 L16,18 L16,20 L4,20 L4,18 L8,18 L8,14 L1,14 Z M3,3 L3,12 L17,12 L17,3 Z M19,10 L23,10 L23,15 L26,15 L21,21 L16,15 L19,15 Z" Fill="#4386B0" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Exporter" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="toolbar" Click="RefreshWorkspace" IsEnabled="{Binding HasWorkspace}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M18,5 A9,9 0 0 0 3,8 L0,6 L0,15 L9,13 L6,11 A5,5 0 0 1 16,8 Z M4,17 A9,9 0 0 0 19,14 L22,16 L22,7 L13,9 L16,11 A5,5 0 0 1 6,14 Z" Fill="#529967" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Rafraîchir" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="toolbar" Command="{Binding SaveCommand}" IsEnabled="{Binding HasChanges}" ToolTip.Tip="Enregistrer les modifications">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M1,1 L17,1 L21,5 L21,21 L1,21 Z M5,2 L5,9 L16,9 L16,2 Z M5,13 L5,20 L17,20 L17,13 Z" Fill="#597C9D" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ComboBox ItemsSource="{Binding MediaFilters}" SelectedIndex="{Binding MediaFilterIndex, Mode=TwoWay}" Width="125" ToolTip.Tip="Films et séries" />
        <ComboBox ItemsSource="{Binding StateFilters}" SelectedIndex="{Binding StateFilterIndex, Mode=TwoWay}" Width="125" ToolTip.Tip="État des fiches" />
        <CheckBox Content="Inverser le filtre" IsChecked="{Binding InvertStateFilter, Mode=TwoWay}" Margin="3,0" VerticalAlignment="Center" />
      </WrapPanel>
      <Button Grid.Column="1" Click="ShowAbout" Classes="toolbar" Margin="6,0,0,0" ToolTip.Tip="À propos de yaDIS3">
        <Path Data="M11,0 A11,11 0 1 0 11,22 A11,11 0 1 0 11,0 Z M10,4 L13,4 L13,7 L10,7 Z M9,9 L13,9 L13,17 L15,17 L15,19 L8,19 L8,17 L10,17 L10,11 L9,11 Z" Fill="#45A3B8" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="250,6,*">
      <Grid RowDefinitions="Auto,*" RowSpacing="4">
        <TextBox Text="{Binding Filter, Mode=TwoWay}" PlaceholderText="Rechercher dans la bibliothèque…" ToolTip.Tip="Filtrer les titres" Height="27" />
        <ListBox x:Name="LibraryList" Grid.Row="1" ItemsSource="{Binding VisibleCards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" BorderBrush="#A5A5A5" BorderThickness="1" Background="White">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:MediaCard">
              <Grid ColumnDefinitions="18,*" Height="20" ToolTip.Tip="{Binding DisplayName}">
                <Border Width="13" Height="13" CornerRadius="7" VerticalAlignment="Center">
                  <Border.Background>
                    <MultiBinding Converter="{StaticResource LibraryStateConverter}" ConverterParameter="color">
                      <Binding Path="FilePath" />
                      <Binding Path="IsDirty" />
                    </MultiBinding>
                  </Border.Background>
                  <TextBlock Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LibraryStateConverter}">
                        <Binding Path="FilePath" />
                        <Binding Path="IsDirty" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </Border>
                <TextBlock Text="{Binding DisplayName}" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="2" BorderBrush="#777777" BorderThickness="1" Background="#C8C8C8" Padding="7">
        <Grid RowDefinitions="*,Auto">
          <Grid Background="#1B1B1B">
            <Image x:Name="DunePreview" Source="{Binding RenderedPreview}" Stretch="Uniform" />
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasRenderedPreview}">
              <TextBlock Text="yaDIS3" FontSize="26" Foreground="#CCCCCC" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding PreviewHint}" Foreground="#CCCCCC" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="380" TextAlignment="Center" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <TextBlock Text="{Binding SelectedCard.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <CheckBox Grid.Column="1" Content="Aperçu de l’épisode" IsChecked="{Binding ShowEpisodePreview, Mode=TwoWay}" IsEnabled="{Binding HasEpisode}" IsVisible="{Binding IsSeries}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="2" ResizeDirection="Rows" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" />
    <TabControl x:Name="EditorTabs" Grid.Row="3" IsEnabled="{Binding !IsBusy}">
      <TabItem Header="{Binding MediaTabTitle}">
        <Grid Margin="8" ColumnDefinitions="2*,12,3*" IsEnabled="{Binding HasCard}">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,60,55" ColumnSpacing="6">
              <StackPanel Spacing="2">
                <TextBlock Text="Titre :" Classes="fieldLabel" />
                <TextBox x:Name="TitleEditor" Text="{Binding SelectedCard.Title, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Année :" Classes="fieldLabel" />
                <TextBox Text="{Binding SelectedCard.Year, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="Note :" Classes="fieldLabel" />
                <TextBox Text="{Binding SelectedCard.Rating, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Acteurs :" Classes="fieldLabel" />
            <TextBox Text="{Binding ActorsText}" IsReadOnly="True" />
            <TextBlock Text="Genres :" Classes="fieldLabel" />
            <TextBox Text="{Binding GenresText}" IsReadOnly="True" />
            <TextBlock Text="Diffuseur :" Classes="fieldLabel" />
            <TextBox Text="{Binding SelectedCard.Network, Mode=TwoWay}" IsReadOnly="False" />
          </StackPanel>
          <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="3">
            <TextBlock Text="Synopsis :" Classes="fieldLabel" />
            <TextBox Grid.Row="1" Text="{Binding SelectedCard.Plot, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Bannière">
        <Grid RowDefinitions="Auto,*" Margin="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Importer une image…" Click="ImportBanner" IsEnabled="{Binding HasCard}" />
            <TextBlock Text="La nouvelle image sera conservée à l’enregistrement." Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <Image Grid.Row="1" Source="{Binding Banner}" Stretch="Uniform" Margin="0,6,0,0" HorizontalAlignment="Left" />
        </Grid>
      </TabItem>
      <TabItem Header="Fanart">
        <Grid RowDefinitions="Auto,*" Margin="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Importer une image…" Click="ImportFanart" IsEnabled="{Binding HasCard}" />
            <TextBlock Text="La nouvelle image sera conservée à l’enregistrement." Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <Image Grid.Row="1" Source="{Binding Fanart}" Stretch="Uniform" Margin="0,6,0,0" HorizontalAlignment="Left" />
        </Grid>
      </TabItem>
      <TabItem Header="Affiche">
        <Grid RowDefinitions="Auto,*" Margin="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Importer une image…" Click="ImportPoster" IsEnabled="{Binding HasCard}" />
            <TextBlock Text="La nouvelle image sera conservée à l’enregistrement." Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <Image Grid.Row="1" Source="{Binding Poster}" Stretch="Uniform" Margin="0,6,0,0" HorizontalAlignment="Left" />
        </Grid>
      </TabItem>
      <TabItem Header="Épisodes" IsVisible="{Binding IsSeries}">
        <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="◀" Command="{Binding PreviousEpisodeCommand}" IsEnabled="{Binding HasEpisode}" />
              <Button Content="▶" Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding HasEpisode}" />
            </StackPanel>
            <ComboBox x:Name="EpisodeChoice" Grid.Column="1" ItemsSource="{Binding SelectedCard.Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:Episode">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Analyser les vidéos…" Grid.Column="2" Click="ScanEpisodes" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="2*,12,3*,12,210" IsEnabled="{Binding HasEpisode}">
            <StackPanel Spacing="3">
              <TextBlock Text="Titre de l’épisode :" Classes="fieldLabel" />
              <TextBox x:Name="EpisodeTitleEditor" Text="{Binding SelectedEpisode.Title, Mode=TwoWay}" />
              <TextBlock Text="Diffusion (AAAA-MM-JJ) :" Classes="fieldLabel" />
              <Grid ColumnDefinitions="*,65" ColumnSpacing="6">
                <TextBox Text="{Binding SelectedEpisode.Aired, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Text="{Binding SelectedEpisode.Rating, Mode=TwoWay}" PlaceholderText="Note" />
              </Grid>
              <TextBlock Text="Réalisation :" Classes="fieldLabel" />
              <TextBox Text="{Binding SelectedEpisode.Director, Mode=TwoWay}" />
              <TextBlock Text="{Binding EpisodePosition}" Classes="muted" />
            </StackPanel>
            <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="3">
              <TextBlock Text="Synopsis :" Classes="fieldLabel" />
              <TextBox Grid.Row="1" Text="{Binding SelectedEpisode.Plot, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
            <Grid Grid.Column="4" RowDefinitions="*,Auto">
              <Image Source="{Binding EpisodeImage}" Stretch="Uniform" />
              <Button Content="Choisir l’image…" Grid.Row="1" Click="ImportEpisodeImage" Margin="0,4,0,0" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Recherche TVDB" IsVisible="{Binding IsSeries}" x:Name="TvdbSearchTab">
        <Grid Margin="10,16" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Configuration TVDB" Click="ConfigureTvdb" />
            <TextBlock Text="{Binding CredentialsLabel}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding Query, Mode=TwoWay}" PlaceholderText="Titre à rechercher…" />
            <Button Grid.Column="1" Content="Rechercher" Command="{Binding SearchCommand}" />
          </Grid>
          <ListBox x:Name="TvdbResults" Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedMatch, Mode=TwoWay}" SelectionChanged="SearchSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:SeriesMatch">
                <StackPanel Margin="4,8" Spacing="6">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxHeight="72" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Text="Ordre des épisodes" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:EpisodeOrder">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Button Grid.Row="4" Content="Appliquer les informations à la série" Command="{Binding ApplySeriesCommand}" HorizontalAlignment="Left" />
        </Grid>
      </TabItem>
      <TabItem Header="Export Dune" x:Name="DuneSettingsTab">
        <ScrollViewer>
          <StackPanel Margin="10,16" Spacing="12">
            <TextBlock Text="Template et rendu" Classes="section" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="render:DuneTemplate">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="Charger un template…" Click="ChooseTemplate" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding TemplateLanguages}" SelectedItem="{Binding TemplateLanguage, Mode=TwoWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox Content="Fonds AAI (sinon JPEG)" IsChecked="{Binding AaiBackgrounds, Mode=TwoWay}" />
              <CheckBox Content="Boîtiers des films" IsChecked="{Binding UseCases, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Traiter la fiche sélectionnée" Command="{Binding ProcessCommand}" />
              <CheckBox Content="Aperçu de l’épisode sélectionné" IsChecked="{Binding ShowEpisodePreview, Mode=TwoWay}" IsEnabled="{Binding HasEpisode}" />
            </StackPanel>
            <TextBlock Text="Chemins de lecture du Dune" Classes="section" />
            <TextBlock Text="Une correspondance par ligne : racine locale =&gt; adresse Dune. Si aucune ne correspond, le chemin Dune enregistré dans la fiche est utilisé." TextWrapping="Wrap" Classes="muted" />
            <TextBox Text="{Binding PathMappings, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" PlaceholderText="Z:\Séries =&gt; smb://nas/Series&#10;/Volumes/Films =&gt; storage_label://MEDIAS/Films" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ExportParentPath, Mode=TwoWay}" PlaceholderText="Dossier de destination" />
              <Button Grid.Column="1" Content="Parcourir…" Click="ChooseExportDestination" />
            </Grid>
            <Button Content="Exporter toute la bibliothèque vers Dune" Command="{Binding ExportCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="L’export crée le sous-dossier yaDIS3-modern. Lors d’un nouvel export, sa version précédente est conservée dans yaDIS3-modern.previous. Les vidéos restent à leur emplacement d’origine." TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding VisibleCountLabel}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="70" Height="5" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Status}" Grid.Column="2" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}" />
      <Button Content="Annuler" Grid.Column="3" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Padding="6,0" />
    </Grid>
  </Grid>
</Window>

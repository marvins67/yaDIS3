<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:YaDIS3.Desktop.ViewModels"
  xmlns:core="using:YaDIS3.Core"
  xmlns:render="using:YaDIS3.Rendering"
  x:Class="YaDIS3.Desktop.Views.SourceFolderWindow"
  x:DataType="vm:SourceFolderViewModel"
  Title="{DynamicResource Text.86}"
  Width="500"
  Height="220"
  CanResize="False"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  FontSize="12"
>
  <Grid
    Margin="12"
    IsEnabled="{Binding !IsResolving}"
    RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
    RowSpacing="6"
  >
    <TextBlock Text="{DynamicResource Text.147.Colon}" />
    <ComboBox
      Grid.Row="1"
      Width="145"
      ItemsSource="{Binding Types}"
      SelectedIndex="{Binding Type, Mode=TwoWay}"
    />
    <TextBlock
      Grid.Row="2"
      Text="{DynamicResource Text.53.Colon}"
    />
    <Grid Grid.Row="3" ColumnDefinitions="*,6,28">
      <TextBox Text="{Binding Path}" IsReadOnly="True" />
      <Button Grid.Column="2" Content="…" Click="Browse" />
    </Grid>
    <Grid
      Grid.Row="4"
      ColumnDefinitions="90,*"
      IsVisible="{Binding !BasicMode}"
    >
      <TextBlock
        Text="{DynamicResource Text.54.Colon}"
        VerticalAlignment="Center"
      />
      <ComboBox
        Grid.Column="1"
        IsEditable="True"
        ItemsSource="{Binding DunePathExamples}"
        Text="{Binding DunePath, Mode=TwoWay}"
        HorizontalAlignment="Stretch"
      />
    </Grid>
    <StackPanel
      Grid.Row="6"
      Orientation="Horizontal"
      Spacing="6"
      HorizontalAlignment="Right"
    >
      <Button
        Content="{DynamicResource Text.159}"
        Click="Accept"
        Width="75"
        IsEnabled="{Binding CanAccept}"
        IsDefault="True"
      />
      <Button
        Content="{DynamicResource Text.90}"
        Click="Cancel"
        Width="75"
        IsCancel="True"
      />
    </StackPanel>
  </Grid>
</Window>
